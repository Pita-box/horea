# Supabase public project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key used by browser and server clients with RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key for server-only admin jobs and trusted backend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase database password for CLI migrations against the remote database.
SUPABASE_DB_PASSWORD=your-supabase-database-password

# Resend API klíč pro odesílání transakčních e-mailů (potvrzení, obnovení hesla).
RESEND_API_KEY=your-resend-api-key

# Odesílatel e-mailů. Musí používat OVĚŘENOU doménu horea.cz v Resend,
# jinak Resend doručí e-maily jen vlastníkovi účtu. Bez nastavení se použije
# výchozí Horea <onboarding@resend.dev> pouze pro dev/test.
RESEND_FROM_EMAIL="Horea <onboarding@resend.dev>"

# Adresa schránky, kam chodí zprávy z veřejného kontaktního formuláře (/api/contact).
# Bez nastavení se použije podpora@horea.cz.
CONTACT_INBOX_EMAIL=podpora@horea.cz

# SMTP2GO — odesílání notifikací rezervací (oddělené od Resendu, aby nesdílely
# denní limit s kritickými auth e-maily). Bez SMTP2GO_API_KEY se notifikace
# rezervací pošlou přes Resend (fallback).
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_FROM_EMAIL="Horea <noreply@horea.cz>"

# GoPay merchant GOID for sandbox or production billing.
GOPAY_GOID=your-gopay-goid

# GoPay OAuth client ID for sandbox or production billing.
GOPAY_CLIENT_ID=your-gopay-client-id

# GoPay OAuth client secret for sandbox or production billing.
GOPAY_CLIENT_SECRET=your-gopay-client-secret

# GoPay REST API base URL. Sandbox: https://gw.sandbox.gopay.com/api,
# production: https://gate.gopay.cz/api. No trailing slash.
GOPAY_API_BASE_URL=https://gw.sandbox.gopay.com/api

# Sdílené tajemství pro HMAC ověření platebních webhooků GoPay
# (/api/webhooks/gopay). Nikdy se neloguje. Bez nastavení handler vrací 500.
GOPAY_WEBHOOK_SECRET=your-gopay-webhook-secret

# Sdílené tajemství pro ochranu denních cron endpointů (/api/cron/*). Vercel Cron
# posílá hlavičku Authorization: Bearer <CRON_SECRET>. Bez shody endpoint vrací 401
# a neprovede žádnou akci. Nikdy se neloguje.
CRON_SECRET=your-cron-secret

# Provozovatelův IBAN pro QR platby (SPAYD fallback při selhání auto-charge).
HOREA_PLATFORM_IBAN=CZ0000000000000000000000

# E-mail administrátora pro provozní notifikace (např. selhání iniciace strhnutí).
# Bez nastavení se notifikace přeskočí a jen zaloguje.
HOREA_ADMIN_EMAIL=info@horea.cz

# Veřejný název Supabase Storage bucketu pro PDF faktury.
SUPABASE_INVOICES_BUCKET=invoices

# Google OAuth client ID for Drive and Sheets backups on a personal Google Drive.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id

# Google OAuth client secret for Drive and Sheets backups on a personal Google Drive.
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth refresh token for the operator account that owns the backup folder.
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Google Drive folder ID where Horea backup Sheets and fallback CSV files are stored.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-google-drive-folder-id


# Clouflare R2 - media storage
R2_ACCOUNT_ID=1d23fxxxxx
R2_ACCESS_KEY_ID=072c49fxxx
R2_SECRET_ACCESS_KEY=b74f9ce17xxx
R2_BUCKET=horea-media
R2_PUBLIC_BASE_URL=https://pub-f371713xxx

# Application log verbosity for server-side logging.
LOG_LEVEL=info

# Telegram notifikace pro operátora platformy (server-only, nikdy se nelogují).
# Token bota z @BotFather. Bez TELEGRAM_BOT_TOKEN + TELEGRAM_OPERATOR_CHAT_ID
# je celá feature no-op (notifikace se přeskočí, příkazy neodpoví).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Chat ID operátora, kam bot posílá notifikace a kde přijímá příkazy. Bez něj
# (spolu s TELEGRAM_BOT_TOKEN) je feature no-op.
TELEGRAM_OPERATOR_CHAT_ID=your-telegram-operator-chat-id

# Sdílené tajemství pro ověření příchozího webhooku (hlavička
# x-telegram-bot-api-secret-token). Bez nastavení webhook odmítá vše (HTTP 401).
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
